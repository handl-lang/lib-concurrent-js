-- lib-concurrent-js: modules this package provides (entry defaults to
-- src/index.hnl; N modules resolve to src/<name>/index.hnl).
{
  -- `js` is intentionally NOT a dep: it is a host/builtin contract
  -- (compile-js binds `from "js"` to __handl_rt shims regardless of dep
  -- tables); declaring it resolves `js` to lib-js's signature-erased
  -- exports instead of the ambient `js.*` call_host surface. See AGENTS.md.
  deps: { concurrent: "branch:main" },
  modules: ["concurrent-js"],
  name: "concurrent-js",
  description: "JavaScript backend for the concurrent step-arrow contract — scheduler over js.call/js.construct primitives.",
  license: "MIT",
  keywords: ["concurrent", "async", "js", "backend", "scheduler"],
  homepage: "https://github.com/handl-lang/lib-concurrent-js",
}
